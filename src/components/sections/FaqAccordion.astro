---
/**
 * Perguntas frequentes — fase "autoridade" da biblioteca B2.
 *
 * Acordeão em `<details>`/`<summary>` nativos: abre, fecha e navega por teclado
 * sem uma linha de JavaScript, o que mantém a regra 10 do padrão (sem framework
 * no cliente) sem perder acessibilidade.
 *
 * Emite também JSON-LD `FAQPage` com as mesmas perguntas — é a única seção da
 * biblioteca que acrescenta dado estruturado além do `Organization` do layout.
 */
import Section from '@components/Section.astro'
import SectionHeader from '@components/SectionHeader.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { faq } from '@data/sections/perguntas'

type Props = SectionProps

const { tone, rhythm } = Astro.props

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}
---

<Section id="perguntas" tone={tone} rhythm={rhythm}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeader eyebrow={faq.eyebrow} title={faq.title} text={faq.text} width="xl" rule />

      <Button cta="perguntas-cta" variant="primary" class="mt-6 w-full sm:w-auto">
        {cta.primary}
      </Button>
    </div>

    <ul class="flex flex-col gap-3">
      {faq.items.map((item) => (
        <li>
          <details
            name="faq"
            class="faq-item group rounded-2xl border border-neutral-gray-200/70 bg-neutral-light shadow-[0_1px_2px_rgba(13,29,48,0.05)] transition-[border-color,box-shadow] duration-300 ease-out hover:border-accent-orange/50"
          >
            <summary
              id={`faq-${item.id}`}
              class="faq-summary flex cursor-pointer items-start justify-between gap-4 px-5 py-4 font-display text-[15px] leading-snug font-extrabold text-ink sm:text-base"
            >
              <span>{item.question}</span>
              <span
                aria-hidden="true"
                class="faq-chevron mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-neutral-gray-100 text-primary-dark transition-[background-color,color,transform] duration-300"
              >
                <Icon name="chevron-down" class="size-4" />
              </span>
            </summary>

            <p class="px-5 pb-5 font-sans text-[14px] leading-relaxed text-ink-soft">
              {item.answer}
            </p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</Section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
<style>
  /* Remove o triângulo nativo em todos os motores. */
  .faq-summary {
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] {
    border-color: rgb(255 107 0 / 0.5);
    box-shadow: 0 24px 48px -28px rgb(0 33 71 / 0.35);
  }

  .faq-item[open] .faq-chevron {
    background-color: var(--color-accent-orange);
    color: var(--color-neutral-light);
    transform: rotate(180deg);
  }

  .faq-item[open] > p {
    animation: faq-in 260ms ease-out both;
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-chevron {
      transition: none;
    }

    .faq-item[open] > p {
      animation: none;
    }

    .faq-item[open] .faq-chevron {
      transform: none;
    }
  }
</style>
