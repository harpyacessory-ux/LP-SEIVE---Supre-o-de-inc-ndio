---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2, com o desvio visual aprovado para a
 * Safe Mine (mockup dos diferenciais, 30/10/2026 — docs/BRIEFING.md).
 *
 * Fundo claro. Texto à esquerda (título com a segunda linha em verde, CTA e selo); à direita,
 * a foto do acionador em card arredondado com o técnico recortado sobreposto. Os 5
 * diferenciais vêm numa barra navy abaixo — é o bloco navy da segunda metade da página.
 *
 * O técnico é posicionado em % da largura do card: `pessoa.png` (1220×1000) traz a figura
 * entre 30% e 68% da largura, do capacete ao quadril. Com 122% de largura e 16% à esquerda,
 * a figura ocupa a metade direita do card e o corte do quadril fica abaixo da borda.
 *
 * Atenção: `npm run compose` sobrescreve este arquivo com o da biblioteca. Para recompor a
 * LP sem perder o mockup, restaure-o do git depois do compose.
 */
import { Picture, Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const [linha1, linha2] = why.titleLines
---

<Section id="diferenciais" tone={tone} rhythm={rhythm}>
  <div class="pt-10 pb-6 lg:pt-16 lg:pb-8">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-12">
      {/* Texto */}
      <div>
        <p class="flex items-center gap-4 font-sans text-[12px] font-bold tracking-[0.24em] text-ink uppercase sm:text-[13px]">
          <span aria-hidden="true" class="h-1 w-12 shrink-0 rounded-full bg-accent-orange"></span>
          {why.eyebrow}
        </p>

        <h2 class="mt-5 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark-900 sm:text-[2.9rem] lg:text-[2.6rem] xl:text-[3.05rem]">
          {linha1}
          <br />
          <span class="text-accent-orange">{linha2}</span>
        </h2>

        <p class="mt-6 max-w-xl font-sans text-[17px] leading-relaxed text-ink-soft sm:text-[19px]">
          {why.text}
        </p>

        <Button
          cta="diferenciais-cta"
          variant="primary"
          class="mt-8 w-full rounded-lg px-9! py-[18px]! text-[18px]! shadow-[0_16px_32px_-16px_rgba(77,127,34,0.75)] sm:w-auto"
        >
          {cta.primary}
        </Button>

        <p class="mt-6 flex items-center gap-3 font-sans text-[15px] text-ink-soft">
          <Icon name={why.trust.icon} class="size-6 shrink-0 text-accent-orange" />
          {why.trust.label}
        </p>
      </div>

      {/* Foto do acionador em card, com o técnico sobreposto */}
      <div class="why-scene relative aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-primary-dark-900 shadow-[0_34px_70px_-40px_rgba(10,29,77,0.6)] sm:aspect-[16/10] lg:aspect-[1.75/1] lg:rounded-[2rem]">
        <Picture
          src={why.scene.src}
          alt={why.scene.alt}
          widths={[640, 1024, 1280]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[35%_center]"
          pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
        />
        <Image
          src={why.person.src}
          alt={why.person.alt}
          format="webp"
          width={1220}
          loading="lazy"
          decoding="async"
          class="why-person"
        />
      </div>
    </div>

    {/* Barra navy com os 5 diferenciais */}
    <ul
      class="why-bar navy-premium mt-10 grid rounded-[1.75rem] px-6 py-2 sm:grid-cols-2 sm:gap-x-8 xl:-mx-6 xl:mt-8 xl:grid-cols-5 xl:gap-x-0 xl:px-3 xl:py-7"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason, i) => (
        <li
          class:list={[
            'why-item flex items-start gap-3.5 py-5 xl:gap-3 xl:px-3 xl:py-1',
            i === why.reasons.length - 1 && 'sm:col-span-2 xl:col-span-1',
          ]}
        >
          <Icon name={reason.icon} class="size-9 shrink-0 text-brand-green xl:size-8" />
          <div>
            <h3 class="font-display text-[17px] leading-snug font-bold text-neutral-light xl:text-[16px]">
              {reason.title}
            </h3>
            <p class="mt-1.5 font-sans text-[14px] leading-relaxed text-neutral-light/80 xl:text-[13.5px]">
              {reason.description}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .why-person {
    position: absolute;
    z-index: 1;
    top: -1%;
    left: 16%;
    width: 122%;
    max-width: none;
    height: auto;
    filter: drop-shadow(0 18px 28px rgb(0 15 35 / 35%));
  }

  /* Divisórias da barra: horizontais até 1280px, verticais com os 5 lado a lado. */
  .why-item + .why-item {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  /* Duas colunas: o 2º item abre a primeira linha ao lado do 1º, sem divisória em cima.
     O seletor repete o `+` para vencer a especificidade da regra acima. */
  @media (width >= 40rem) and (width < 80rem) {
    .why-item + .why-item:nth-child(2) {
      border-top: 0;
    }
  }

  @media (width >= 80rem) {
    .why-item + .why-item {
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 0.15);
    }
  }
</style>
