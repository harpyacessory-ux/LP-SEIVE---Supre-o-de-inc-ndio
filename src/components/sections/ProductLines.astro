---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2, com o desvio visual aprovado para a
 * Safe Mine (mockup da seção do kit, 29/10/2026 — docs/BRIEFING.md).
 *
 * Cabeçalho com título à esquerda e texto à direita; três cards claros com chip, foto
 * grande e checks; o item escuro (`dark: true`) vira a faixa azul de largura total abaixo
 * dos cards, com o CTA visível. Cada card claro é inteiro clicável por um botão sem texto
 * que o cobre (rótulo acessível em `aria-label`), para manter o `data-cta` por item.
 *
 * Atenção: `npm run compose` sobrescreve este arquivo com o da biblioteca. Para recompor a
 * LP sem perder o mockup, restaure-o do git depois do compose.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const cards = productLines.items.filter((line) => !line.dark)
const band = productLines.items.find((line) => line.dark)
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  {/* Cabeçalho: título à esquerda, texto à direita separado por uma linha */}
  <div class="grid gap-6 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-center lg:gap-14">
    <div>
      <p class="flex items-center gap-4 font-sans text-[12px] font-bold tracking-[0.24em] text-ink uppercase sm:text-[13px]">
        <span aria-hidden="true" class="h-1 w-10 shrink-0 rounded-full bg-accent-orange"></span>
        {productLines.eyebrow}
      </p>
      <h2 class="mt-4 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-primary-dark-900 sm:text-[2.9rem] lg:text-[3.3rem]">
        {productLines.title}
      </h2>
      <span aria-hidden="true" class="mt-4 block h-1 w-16 rounded-full bg-accent-orange"></span>
    </div>

    <p class="max-w-xl font-sans text-[17px] leading-relaxed text-ink-soft sm:text-[19px] lg:border-l lg:border-primary-dark/15 lg:py-3 lg:pl-14">
      {productLines.text}
    </p>
  </div>

  <BrandCarousel />

  {/* Três cards claros */}
  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {cards.map((line) => (
      <li class="product-card group relative flex flex-col rounded-[1.75rem] bg-neutral-light p-6 shadow-[0_24px_48px_-32px_rgba(10,29,77,0.35)] ring-1 ring-primary-dark/[0.06] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_32px_60px_-30px_rgba(10,29,77,0.45)] sm:p-8">
        <span class="self-start rounded-full bg-accent-orange/10 px-4 py-1.5 font-sans text-[11px] font-bold tracking-[0.16em] text-accent-orange uppercase sm:text-[12px]">
          {line.tag}
        </span>

        <div class="relative mt-2 flex h-56 items-center justify-center sm:h-64">
          <span
            aria-hidden="true"
            class="absolute bottom-1 left-1/2 h-5 w-40 -translate-x-1/2 rounded-[100%] bg-primary-dark/15 blur-md"
          />
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="relative z-[1] max-h-full w-auto max-w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </div>

        <h3 class="mt-6 font-display text-[1.45rem] leading-tight font-extrabold tracking-[-0.01em] text-primary-dark-900 sm:text-[1.6rem] lg:text-[1.38rem] xl:text-[1.5rem]">
          {line.title}
        </h3>
        <p class="mt-2 font-sans text-[15px] leading-relaxed text-ink-soft sm:text-base">
          {line.description}
        </p>

        <ul class="mt-5 flex flex-col gap-3">
          {line.features.map((feature) => (
            <li class="flex items-center gap-3 font-sans text-[15px] font-medium text-ink sm:text-base">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent-orange/10 text-accent-orange">
                <Icon name="check" class="size-3.5" />
              </span>
              {feature}
            </li>
          ))}
        </ul>

        {/* Card inteiro clicável: abre o atendimento com o rastreio do item */}
        <button
          type="button"
          data-cta={`linhas-${line.id}`}
          aria-label={`${cta.card}: ${line.title}`}
          class="btn-slave-whats absolute inset-0 z-[3] cursor-pointer rounded-[1.75rem]"
        />
      </li>
    ))}
  </ul>

  {/* Faixa azul de peças e suporte (o item escuro) */}
  {band && (
    <div class="linhas-band navy-premium relative mt-6 grid items-center gap-6 overflow-hidden rounded-[1.75rem] px-6 py-8 sm:px-10 lg:-mx-4 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto] lg:gap-0 lg:px-8 lg:py-5">
      <Image
        src={band.photo.src}
        alt={band.photo.alt}
        format="webp"
        width={640}
        loading="lazy"
        decoding="async"
        class="mx-auto h-36 w-auto object-contain sm:h-44 lg:mx-0 lg:h-40"
      />

      <div class="lg:border-l lg:border-white/15 lg:px-8">
        <p class="flex items-center gap-4 font-sans text-[12px] font-bold tracking-[0.24em] text-neutral-light/85 uppercase">
          <span aria-hidden="true" class="h-1 w-9 shrink-0 rounded-full bg-accent-orange" />
          {band.tag}
        </p>
        <h3 class="mt-3 font-display text-[1.6rem] leading-tight font-extrabold text-neutral-light sm:text-[1.9rem] lg:text-[1.55rem] xl:text-[1.75rem]">
          {band.title}
        </h3>
        <p class="mt-2 font-sans text-[16px] text-neutral-light/75 sm:text-[17px]">
          {band.description}
        </p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5 xl:flex-nowrap">
          {band.features.map((feature) => (
            <li class="flex items-center gap-2 font-sans text-[15px] whitespace-nowrap text-neutral-light/90 lg:text-[14px] xl:text-[15px]">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full border border-accent-orange/70 text-accent-orange">
                <Icon name="check" class="size-3.5" />
              </span>
              {feature}
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:border-l lg:border-white/15 lg:pl-10">
        <button
          type="button"
          data-cta={`linhas-${band.id}`}
          class="btn-slave-whats inline-flex w-full items-center justify-center gap-3 rounded-full bg-accent-orange px-7 py-4 font-sans text-[16px] font-semibold text-neutral-light shadow-[0_14px_30px_-14px_rgba(0,0,0,0.6)] transition-colors duration-200 hover:bg-accent-orange-dark sm:w-auto sm:text-[17px]"
        >
          {cta.card}
          <Icon name="arrow-right" class="size-5 shrink-0" />
        </button>
      </div>
    </div>
  )}
</Section>

<style>
  .product-card :focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card img,
    .linhas-band button {
      transition: none !important;
    }
    .product-card:hover {
      transform: none;
    }
  }
</style>
