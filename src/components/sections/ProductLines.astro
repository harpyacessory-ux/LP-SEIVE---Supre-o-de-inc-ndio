---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2.
 *
 * Cabeçalho à esquerda, carrossel de logos à direita, grid de 3–4 cards com um
 * card escuro. Fundo e respiro vêm da composição via `tone`/`rhythm`.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const lines = productLines.items
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <Eyebrow>{productLines.eyebrow}</Eyebrow>
      <h2 class="mt-3 font-display text-3xl leading-tight font-extrabold text-ink sm:text-4xl">
        {productLines.title}
      </h2>
      <p class="mt-3 max-w-[330px] font-sans text-[15px] leading-relaxed text-ink-soft">
        {productLines.text}
      </p>
    </div>

    <div class="min-w-0 flex-1 sm:pl-10">
      <BrandCarousel />
    </div>
  </div>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {lines.map((line, i) => (
      <article
        class:list={[
          'product-card group relative flex flex-col overflow-hidden rounded-2xl border transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5',
          line.dark
            ? 'navy-premium border-white/10 shadow-[0_18px_40px_-24px_rgba(0,24,48,0.6)] hover:border-accent-orange/60 hover:shadow-[0_28px_56px_-24px_rgba(0,24,48,0.75)]'
            : 'border-neutral-gray-200/70 bg-neutral-light shadow-[0_1px_2px_rgba(13,29,48,0.05)] hover:border-accent-orange/50 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.35)]',
        ]}
      >
        {/* Linha de acento no topo — cresce no hover */}
        <span
          aria-hidden="true"
          class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
        />

        {/* Palco da imagem */}
        <div
          class:list={[
            'relative flex h-40 items-center justify-center overflow-hidden',
            line.dark ? 'product-card__stage--dark' : 'product-card__stage--light',
          ]}
        >
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={line.dark ? 640 : 360}
            loading="lazy"
            decoding="async"
            class:list={[
              line.dark
                ? 'absolute inset-0 z-[1] h-full w-full object-contain object-center transition-transform duration-500 ease-out group-hover:scale-[1.04]'
                : 'relative z-[1] max-h-[7.75rem] w-auto max-w-[78%] object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:-rotate-2 group-hover:scale-[1.07]',
            ]}
          />

          <span class="absolute top-4 left-4 z-[2] font-display text-[11px] font-extrabold tracking-[0.2em] text-primary-dark/40">
            {String(i + 1).padStart(2, '0')}
          </span>

          <span class="absolute top-3.5 right-4 z-[2] rounded-full border border-primary-dark/10 bg-neutral-light px-2.5 py-1 font-sans text-[10px] font-bold tracking-[0.16em] text-primary-dark/75 uppercase">
            {line.tag}
          </span>

          {!line.dark && (
            <span
              aria-hidden="true"
              class="absolute bottom-3 left-1/2 h-4 w-28 -translate-x-1/2 rounded-[100%] bg-primary-dark/20 opacity-50 blur-md transition-opacity duration-500 group-hover:opacity-90"
            />
          )}
        </div>

        {/* Conteúdo */}
        <div class="flex flex-1 flex-col px-6 pt-4 pb-4">
          <h3
            class:list={[
              'font-display text-lg leading-snug font-extrabold',
              line.dark ? 'text-neutral-light' : 'text-ink',
            ]}
          >
            {line.title}
          </h3>

          <p
            class:list={[
              'mt-2 font-sans text-[13px] leading-relaxed',
              line.dark ? 'text-neutral-light/65' : 'text-ink-soft',
            ]}
          >
            {line.description}
          </p>

          <ul class="mt-4 mb-4 flex flex-col gap-2">
            {line.features.map((feature) => (
              <li
                class:list={[
                  'flex items-center gap-2.5 font-sans text-[13px] font-medium',
                  line.dark ? 'text-neutral-light/90' : 'text-ink',
                ]}
              >
                <span
                  class:list={[
                    'flex size-5 shrink-0 items-center justify-center rounded-full text-accent-orange',
                    line.dark ? 'bg-accent-orange/20' : 'bg-accent-orange/10',
                  ]}
                >
                  <Icon name="check" class="size-3" />
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-cta={`linhas-${line.id}`}
            class:list={[
              'btn-slave-whats mt-auto flex items-center justify-between gap-3 border-t pt-3 font-sans text-[13px] font-bold transition-colors duration-200 hover:text-accent-orange',
              line.dark
                ? 'border-white/10 text-neutral-light'
                : 'border-neutral-gray-200/60 text-primary-dark',
            ]}
          >
            <span>{cta.card}</span>
            <span
              class:list={[
                'flex size-8 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:bg-accent-orange group-hover:text-neutral-light',
                line.dark
                  ? 'bg-white/10 text-neutral-light'
                  : 'bg-neutral-gray-100 text-primary-dark',
              ]}
            >
              <Icon name="arrow-right" class="size-3.5" />
            </span>
          </button>
        </div>
      </article>
    ))}
  </div>
</Section>

<style>
  /* Palco claro: gradiente suave + malha de pontos que esmaece nas bordas */
  .product-card__stage--light {
    background-image: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  }

  .product-card__stage--light::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(0, 33, 71, 0.16) 1px, transparent 1.2px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    -webkit-mask-image: radial-gradient(ellipse at center, transparent 32%, black 90%);
    opacity: 0.7;
    pointer-events: none;
  }

  /* Palco do card escuro: painel branco para a foto de marcas */
  .product-card__stage--dark {
    background-color: #ffffff;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  /* Canto técnico discreto que aparece no hover */
  .product-card::after {
    content: '';
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 14px;
    height: 14px;
    border-right: 2px solid var(--color-accent-orange);
    border-bottom: 2px solid var(--color-accent-orange);
    opacity: 0;
    transform: translate(4px, 4px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
    pointer-events: none;
  }

  .product-card:hover::after {
    opacity: 0.9;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card img,
    .product-card span {
      transition: none !important;
    }
    .product-card:hover {
      transform: none;
    }
  }
</style>
