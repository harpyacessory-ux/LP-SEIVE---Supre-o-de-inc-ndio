---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2, com o desvio visual aprovado para a
 * Safe Mine (mockup claro das aplicações, 30/10/2026 — docs/BRIEFING.md).
 *
 * Fundo claro com chamas suaves nos cantos de baixo (imagem em sangria total por baixo do
 * respiro da seção), cabeçalho à esquerda com a segunda linha do título em verde e 4 cards
 * brancos com foto, texto e o rodapé "Solicitar cotação". O card inteiro é clicável por um
 * botão sem texto que o cobre (`data-cta="aplicacoes-{id}"`, rótulo em `aria-label`).
 *
 * Atenção: `npm run compose` sobrescreve este arquivo com o da biblioteca. Para recompor a
 * LP sem perder o mockup, restaure-o do git depois do compose.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { applications } from '@data/sections/aplicacoes'

import fundo from '@assets/fundo-chamas-claro.jpg'

type Props = SectionProps

const { tone, rhythm } = Astro.props

// Quebra do mockup: "… máquinas pesadas / e equipamentos móveis" (só a partir do tablet).
const quebra = applications.title.lastIndexOf(' e ')
const tituloA = quebra > 0 ? applications.title.slice(0, quebra) : applications.title
const tituloB = quebra > 0 ? applications.title.slice(quebra + 1) : ''
---

<Section id="aplicacoes" tone={tone} rhythm={rhythm} class="relative isolate overflow-hidden">
  {/* Fundo: claro, com chamas suaves nos cantos de baixo. A foto encaixa pela largura,
      ancorada embaixo; acima dela, o mesmo tom claro do fundo da foto. */}
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[#f7fcfe]">
    <Image
      src={fundo}
      alt=""
      format="webp"
      widths={[768, 1280, 1672]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="absolute bottom-0 left-0 h-auto w-full max-w-none min-w-[48rem] max-sm:left-1/2 max-sm:-translate-x-1/2 sm:min-w-0"
    />
  </div>

  <div class="pt-4 pb-10 lg:pt-6 lg:pb-14">
    {/* Cabeçalho à esquerda: traço verde, eyebrow, título com a segunda linha em verde */}
    <div class="max-w-5xl">
      <span aria-hidden="true" class="block h-1 w-12 rounded-full bg-accent-orange"></span>
      <p class="mt-4 font-sans text-[12px] font-bold tracking-[0.24em] text-ink-soft uppercase sm:text-[13px]">
        {applications.eyebrow}
      </p>
      <h2 class="mt-3 font-display text-[2.3rem] leading-[1.04] font-extrabold tracking-[-0.035em] text-primary-dark-900 sm:text-[3rem] lg:text-[3.6rem] xl:text-[4rem]">
        {tituloA} <br class="hidden sm:inline" />
        <span class="text-accent-orange">{tituloB}</span>
      </h2>
      <p class="mt-5 font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[18px] lg:text-[19px]">
        {applications.text}
      </p>
    </div>

    {/* Quatro cards */}
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4 xl:gap-5">
      {applications.items.map((app) => (
        <li class="app-card group relative flex flex-col overflow-hidden rounded-2xl bg-neutral-light shadow-[0_26px_50px_-30px_rgba(10,29,77,0.4)] ring-1 ring-primary-dark/[0.06] transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_34px_60px_-30px_rgba(10,29,77,0.5)]">
          <div class="relative aspect-[4/3] overflow-hidden bg-primary-dark-900">
            <Image
              src={app.photo.src}
              alt={app.photo.alt}
              format="webp"
              width={640}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
            />
          </div>

          <div class="flex flex-1 flex-col px-6 pt-6 pb-5">
            <h3 class="font-display text-[1.3rem] leading-snug font-extrabold tracking-[-0.015em] text-primary-dark-900 lg:text-[1.1rem] xl:text-[1.25rem]">
              {app.label}
            </h3>
            <p class="mt-2 mb-6 font-sans text-[15px] leading-relaxed text-ink-soft">
              {app.description}
            </p>

            <span class="mt-auto flex items-center justify-between border-t border-primary-dark/10 pt-4 font-sans text-[16px] font-semibold text-accent-orange">
              {cta.primary}
              <Icon
                name="arrow-right"
                class="size-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
              />
            </span>
          </div>

          {/* Card inteiro clicável: abre o atendimento com o rastreio da aplicação */}
          <button
            type="button"
            data-cta={`aplicacoes-${app.id}`}
            aria-label={`${cta.primary}: ${app.label}`}
            class="btn-slave-whats absolute inset-0 z-[2] cursor-pointer rounded-2xl"
          />
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .app-card :focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card img,
    .app-card svg {
      transition: none !important;
    }
    .app-card:hover {
      transform: none;
    }
  }
</style>
