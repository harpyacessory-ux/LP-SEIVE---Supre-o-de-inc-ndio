---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), com o desvio visual aprovado para a Safe Mine
 * (mockup de abertura, 29/10/2026 — docs/BRIEFING.md).
 *
 * Banner em sangria total, por baixo do header flutuante. Grid desktop: texto (1fr) ·
 * coluna da direita (380px) com o slot do chat e o card do produto. A faixa de três pontos
 * fecha o hero, em largura total.
 *
 * Slot do chat: fora do WordPress ele só contém o texto cru do shortcode, e o CSS o esconde
 * (`:not(:has(*))`) — o card do produto aparece no lugar, como no mockup. Quando o plugin
 * renderiza o chat, o chat ocupa a coluna e o card sai.
 *
 * Abra a página com `?grid=1` para ver as colunas.
 */
import { Image, Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { hero, cta } from '../data/content'
---

<section class="hero relative isolate overflow-hidden bg-primary-dark-900" data-hero>
  {/* Palco: banner + conteúdo. A foto termina onde a faixa começa, como no mockup. */}
  <div class="hero-stage relative">
    {/* z1 — banner em sangria total */}
    <div class="absolute inset-0 z-[1]">
      <Picture
        src={hero.banner.src}
        alt={hero.banner.alt}
        widths={[640, 1024, 1536, 1981]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-photo-img h-full w-full object-cover"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    {/* z2 — véus: azul à esquerda (texto), topo (header) e base (faixa) */}
    <div class="hero-veil pointer-events-none absolute inset-0 z-[2]"></div>

    {/* z5 — conteúdo */}
    <div class="relative z-[5] mx-auto max-w-page px-6 pt-32 pb-10 sm:pt-36 lg:px-10 lg:pt-36 lg:pb-11">
      <div class="hero-grid grid items-end gap-10 lg:gap-x-12">
        {/* Coluna 1 — textos */}
        <div class="max-w-[720px]">
          <p class="flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.24em] text-neutral-light/85 uppercase sm:text-[13px]">
            <span aria-hidden="true" class="h-1 w-10 shrink-0 rounded-full bg-brand-green"></span>
            {hero.eyebrow}
          </p>

          <h1 class="mt-4 font-display text-[2.5rem] leading-[1.05] font-extrabold tracking-[-0.025em] text-neutral-light sm:text-[3.25rem] lg:text-[3rem] xl:max-w-[660px] xl:text-[3.7rem]">
            {hero.title}
          </h1>

          <p class="mt-5 max-w-[600px] font-sans text-lg leading-relaxed text-neutral-light/85 sm:text-[1.2rem]">
            {hero.text}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-5">
            <Button
              cta="hero-primary"
              variant="primary"
              class="rounded-md px-8! py-4! text-[17px]! font-bold! shadow-[0_16px_36px_-16px_rgba(0,0,0,0.7)]"
            >
              {cta.primary}
            </Button>

            {/* Secundário do mockup: link que rola até o kit — não abre atendimento */}
            <a
              href={hero.secondary.href}
              data-cta="hero-secondary"
              class="group inline-flex items-center gap-3 border-b-2 border-neutral-light/70 pb-1.5 font-sans text-[17px] font-semibold text-neutral-light transition-colors duration-200 hover:border-brand-green motion-reduce:transition-none"
            >
              {hero.secondary.label}
              <Icon
                name="arrow-right"
                class="size-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
              />
            </a>
          </div>

          <p class="mt-7 flex items-center gap-3 font-sans text-[15px] text-neutral-light/85 sm:text-base">
            <Icon name={hero.trust.icon} class="size-8 shrink-0 text-brand-green" />
            {hero.trust.label}
          </p>
        </div>

        {/* Coluna 2 — chat do plugin ou, sem ele, o card do produto */}
        <div class="hero-aside w-full lg:w-[380px]">
          <div class="hero-chat min-h-[430px] w-full" data-shortcode-slot>
            <slot name="shortcode" />
          </div>

          <article class="hero-product relative overflow-hidden rounded-2xl bg-[linear-gradient(135deg,#ffffff_0%,#eef1f6_100%)] shadow-[0_30px_60px_-30px_rgba(0,0,0,0.8)]">
            <div class="relative z-[1] flex h-[240px] max-w-[58%] flex-col justify-center p-6 sm:h-[270px] sm:p-7 lg:h-[262px]">
              <span aria-hidden="true" class="h-1 w-8 rounded-full bg-accent-orange"></span>
              <p class="mt-4 font-display text-[17px] font-extrabold tracking-[0.04em] text-ink uppercase">
                {hero.product.eyebrow}
              </p>
              <p class="mt-2.5 font-sans text-[15px] leading-relaxed text-ink-soft">
                {hero.product.text}
              </p>
            </div>
            <Image
              src={hero.product.photo.src}
              alt={hero.product.photo.alt}
              width={300}
              format="webp"
              loading="eager"
              decoding="async"
              class="absolute right-3 bottom-2 h-[94%] w-auto object-contain drop-shadow-[0_18px_22px_rgba(0,0,0,0.25)] sm:right-6"
            />
          </article>
        </div>
      </div>
    </div>
  </div>

  {/* Faixa de três pontos — largura total, fecha o hero */}
  <div class="hero-strip relative z-[5] border-t border-white/10 bg-primary-dark-900">
    <ul
      class="mx-auto grid max-w-page px-6 sm:grid-cols-3 lg:px-10"
      aria-label="Destaques do sistema"
    >
      {hero.points.map((point) => (
        <li class="hero-point flex items-center gap-5 py-5 sm:justify-center sm:py-7 lg:py-8">
          <Icon name={point.icon} class="size-11 shrink-0 text-brand-green lg:size-14" />
          <span class="font-sans text-[15px] leading-snug text-neutral-light/90 lg:text-[18px]">
            <span class="block">{point.line1}</span>
            <span class="block">{point.line2}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-12">
        <div class="border-x border-dashed border-white/60">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-brand-green lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-brand-green">
            col 2 · 380px · chat ou produto
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Assunto (escavadeira) à direita; no mobile, centrado nela. */
  .hero-photo-img {
    object-position: 72% center;
  }

  .hero-veil {
    background:
      linear-gradient(to bottom, rgb(10 29 77 / 0.55) 0%, transparent 22%),
      linear-gradient(to top, rgb(10 29 77 / 0.6) 0%, transparent 30%),
      linear-gradient(
        to right,
        rgb(10 29 77 / 0.92) 0%,
        rgb(10 29 77 / 0.8) 45%,
        rgb(10 29 77 / 0.35) 75%,
        rgb(10 29 77 / 0.2) 100%
      );
  }

  /* Slot do chat: só aparece quando o plugin renderiza algo (elemento, não texto cru). */
  .hero-chat:not(:has(*)) {
    display: none;
  }

  .hero-aside:has(.hero-chat *) .hero-product {
    display: none;
  }

  /* Divisórias da faixa: horizontais no mobile, verticais a partir de tablet. */
  .hero-point + .hero-point {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (width >= 40rem) {
    .hero-point + .hero-point {
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 0.15);
    }
  }

  @media (width >= 64rem) {
    /* Col 1 texto · col 2 chat ou produto (380px) */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 380px;
    }

    .hero-photo-img {
      object-position: right center;
    }

    .hero-veil {
      background:
        linear-gradient(to bottom, rgb(10 29 77 / 0.5) 0%, transparent 18%),
        linear-gradient(to top, rgb(10 29 77 / 0.55) 0%, transparent 22%),
        linear-gradient(to right, rgb(10 29 77 / 0.9) 0%, rgb(10 29 77 / 0.55) 38%, transparent 62%);
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
