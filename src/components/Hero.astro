---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.2), com o desvio visual aprovado para a Safe Mine
 * (mockup claro de abertura, 29/10/2026 — docs/BRIEFING.md).
 *
 * Fundo claro. Grid desktop: texto · cena (foto em card arredondado, com o reservatório SEIVE
 * sobreposto ao canto e a legenda abaixo). A faixa de três pontos fecha o hero.
 *
 * O banner tem o lado esquerdo em azul sólido; dentro do card ele entra ampliado (118% da
 * altura) e ancorado à direita, para mostrar só a cena da mina.
 *
 * Slot do chat: fora do WordPress ele só contém o texto cru do shortcode, e o CSS o esconde
 * (`:not(:has(*))`) — a cena aparece no lugar. Quando o plugin renderiza o chat, o chat
 * ocupa a coluna e a cena sai.
 *
 * Abra a página com `?grid=1` para ver as colunas.
 */
import { Image, Picture } from 'astro:assets'
import Icon from './Icon.astro'
import Button from './Button.astro'
import { hero, cta } from '../data/content'

// O H1 continua sendo `hero.title` (é ele que o check:lp confere); o destaque só muda a cor.
const at = hero.title.indexOf(hero.highlight)
const titleBefore = at >= 0 ? hero.title.slice(0, at) : hero.title
const titleAfter = at >= 0 ? hero.title.slice(at + hero.highlight.length) : ''

/** Mesmo valor do preload em Layout.astro: a foto é renderizada ~2,6× a altura do card. */
const HERO_SCENE_SIZES = '(min-width: 1280px) 1150px, (min-width: 1024px) 85vw, 165vw'
---

<section class="hero relative isolate overflow-hidden bg-neutral-gray-100" data-hero>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(900px_520px_at_18%_20%,rgb(255_255_255/0.9)_0%,transparent_70%)]"
  ></div>

  <div class="relative z-[1] mx-auto max-w-page px-6 pt-28 pb-14 sm:pt-32 lg:px-10 lg:pt-32 lg:pb-16">
    <div class="hero-grid grid items-center gap-12 lg:gap-x-8">
      {/* Coluna 1 — textos */}
      <div>
        <p class="flex items-center gap-4 font-sans text-[12px] font-bold tracking-[0.24em] text-ink uppercase sm:text-[13px]">
          <span aria-hidden="true" class="h-1 w-12 shrink-0 rounded-full bg-accent-orange"></span>
          {hero.eyebrow}
        </p>

        <h1 class="mt-5 font-display text-[2.6rem] leading-[1.03] font-extrabold tracking-[-0.035em] text-primary-dark-900 sm:text-[3.4rem] lg:text-[3.2rem] xl:text-[3.9rem]">
          {titleBefore}
          <span class="text-accent-orange">{at >= 0 ? hero.highlight : ''}</span>
          {titleAfter}
        </h1>

        <p class="mt-6 max-w-[34rem] font-sans text-[17px] leading-relaxed text-ink-soft sm:text-[19px]">
          {hero.text}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-9 gap-y-5">
          <Button
            cta="hero-primary"
            variant="primary"
            class="rounded-lg px-9! py-[18px]! text-[18px]! shadow-[0_16px_32px_-16px_rgba(77,127,34,0.75)]"
          >
            {cta.primary}
          </Button>

          {/* Secundário do mockup: link que rola até o kit — não abre atendimento */}
          <a
            href={hero.secondary.href}
            data-cta="hero-secondary"
            class="group inline-flex items-center gap-3 border-b-2 border-ink/60 pb-1.5 font-sans text-[17px] font-semibold text-primary-dark-900 transition-colors duration-200 hover:border-accent-orange motion-reduce:transition-none"
          >
            {hero.secondary.label}
            <Icon
              name="arrow-right"
              class="size-5 shrink-0 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
            />
          </a>
        </div>

        <p class="mt-8 flex items-center gap-3 font-sans text-[15px] text-ink-soft sm:text-base">
          <Icon name={hero.trust.icon} class="size-9 shrink-0 text-accent-orange" />
          {hero.trust.label}
        </p>
      </div>

      {/* Coluna 2 — chat do plugin ou, sem ele, a cena */}
      <div class="hero-aside relative">
        <div class="hero-chat min-h-[430px] w-full" data-shortcode-slot>
          <slot name="shortcode" />
        </div>

        <div class="hero-visual">
          <div class="relative aspect-[1.58/1]">
            {/* Foto da mina em card arredondado */}
            <div class="hero-scene absolute inset-0 overflow-hidden rounded-[1.75rem] bg-primary-dark-900 shadow-[0_34px_70px_-40px_rgba(10,29,77,0.65)] lg:rounded-[2.5rem]">
              <Picture
                src={hero.banner.src}
                alt={hero.banner.alt}
                widths={[640, 1024, 1536, 1981]}
                sizes={HERO_SCENE_SIZES}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="hero-scene-img"
              />
            </div>

            {/* Reservatório SEIVE sobreposto ao canto inferior esquerdo */}
            <Image
              src={hero.product.photo.src}
              alt={hero.product.photo.alt}
              width={420}
              format="webp"
              loading="eager"
              decoding="async"
              class="hero-product absolute -bottom-[22%] -left-[5%] z-[2] h-[86%] w-auto drop-shadow-[0_28px_28px_rgba(10,29,77,0.35)]"
            />
          </div>

          {/* Legenda ao lado do produto */}
          <div class="mt-6 pl-[40%] sm:pl-[36%] lg:mt-8 lg:pl-[33%]">
            <span aria-hidden="true" class="block h-1 w-10 rounded-full bg-accent-orange"></span>
            <p class="mt-3 font-display text-[15px] font-extrabold tracking-[0.14em] text-primary-dark-900 uppercase sm:text-[17px]">
              {hero.product.eyebrow}
            </p>
            <p class="mt-1 font-sans text-[14px] text-ink-soft sm:text-[15px]">
              {hero.product.text}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Faixa de três pontos — largura total, fecha o hero */}
  <div class="hero-strip relative z-[1] border-t border-primary-dark/10 bg-primary-dark/[0.035]">
    <ul
      class="mx-auto grid max-w-page px-6 sm:grid-cols-3 lg:px-10"
      aria-label="Destaques do sistema"
    >
      {hero.points.map((point) => (
        <li class="hero-point flex items-center gap-4 py-5 sm:px-4 sm:py-7 sm:first:pl-0 lg:gap-5 lg:px-6 lg:py-8">
          <Icon name={point.icon} class="size-11 shrink-0 text-accent-orange lg:size-12" />
          <span class="font-sans leading-snug">
            <span class="block font-display text-[15px] font-bold text-primary-dark-900 lg:text-base xl:whitespace-nowrap">
              {point.line1}
            </span>
            <span class="mt-0.5 block text-[14px] text-ink-soft lg:text-[15px]">{point.line2}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* Overlay de depuração: ?grid=1 */}
  <div data-hero-grid hidden class="pointer-events-none absolute inset-0 z-[9]">
    <div class="mx-auto h-full max-w-page px-6 lg:px-10">
      <div class="hero-grid grid h-full lg:gap-x-8">
        <div class="border-x border-dashed border-ink/50">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 1 · texto
          </span>
        </div>
        <div class="hidden border-x border-dashed border-accent-orange lg:block">
          <span class="m-2 inline-block bg-black/60 px-2 font-mono text-[11px] text-white">
            col 2 · cena (chat ou foto + produto)
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Foto ampliada e ancorada à direita: o azul do lado esquerdo do banner fica fora do card. */
  .hero-scene-img {
    position: absolute;
    top: 50%;
    right: 0;
    width: auto;
    max-width: none;
    height: 118%;
    transform: translateY(-50%);
  }

  /* Slot do chat: só aparece quando o plugin renderiza algo (elemento, não texto cru). */
  .hero-chat:not(:has(*)) {
    display: none;
  }

  .hero-aside:has(.hero-chat *) .hero-visual {
    display: none;
  }

  /* Divisórias da faixa: horizontais no mobile, verticais a partir de tablet. */
  .hero-point + .hero-point {
    border-top: 1px solid rgb(16 44 115 / 0.1);
  }

  @media (width >= 40rem) {
    .hero-point + .hero-point {
      border-top: 0;
      border-left: 1px solid rgb(16 44 115 / 0.14);
    }
  }

  @media (width >= 64rem) {
    /* Col 1 texto · col 2 cena */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (width >= 80rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 37rem) minmax(0, 1fr);
    }
  }

  /* A cena sangra para a direita quando sobra margem fora do container. */
  @media (width >= 87.5rem) {
    .hero-visual {
      margin-right: -4rem;
    }
  }
</style>

<script>
  // Overlay de depuração do grid: abra a página com ?grid=1
  if (new URLSearchParams(location.search).get('grid') === '1') {
    document.querySelectorAll<HTMLElement>('[data-hero-grid]').forEach((el) => {
      el.hidden = false
    })
  }
</script>
