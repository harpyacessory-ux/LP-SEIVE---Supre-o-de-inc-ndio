---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.5), com o desvio visual aprovado para a Safe Mine
 * (mockup da cotação, 30/10/2026 — docs/BRIEFING.md): navy sólido com filete verde no topo.
 * Uma linha: copyright · endereço · crédito da B2. Sem menu, redes, telefone, e-mail, logo
 * ou formulário.
 */
import Icon from './Icon.astro'
import { site } from '../data/site'
import { footer } from '../data/content'

const year = new Date().getFullYear()
---

<footer class="border-t-2 border-accent-orange bg-primary-dark-900">
  <div class="mx-auto flex max-w-page flex-col items-center gap-3 px-6 py-7 text-center lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:px-10 lg:text-left">
    <p class="shrink-0 font-sans text-[13px] text-neutral-light/75 sm:text-sm">
      © {year} {site.brand}. Todos os direitos reservados.
    </p>

    <address class="flex items-center gap-2.5 font-sans text-[13px] text-neutral-light/85 not-italic sm:text-sm lg:whitespace-nowrap">
      <Icon name="map-pin" class="size-4 shrink-0 text-brand-green" />
      <span>{site.address}</span>
    </address>

    <p class="shrink-0 font-sans text-[13px] text-neutral-light/75 sm:text-sm">
      Desenvolvido por{' '}
      <a
        href={footer.credit.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-neutral-light transition-colors hover:text-brand-green"
      >
        {footer.credit.label}
      </a>
    </p>
  </div>
</footer>
