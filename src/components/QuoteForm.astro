---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4), com o desvio visual aprovado para a Safe Mine
 * (mockup da cotação, 30/10/2026 — docs/BRIEFING.md).
 *
 * Grid 0.85fr · 1fr: formulário (shortcode) num card branco à esquerda, texto à direita.
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * Fora do WordPress o slot só contém o texto cru do shortcode: o CSS o esconde
 * (`:not(:has(*))`) e o card fica vazio, como no mockup. No WordPress o plugin renderiza o
 * formulário dentro do card.
 */
import Icon from './Icon.astro'
import { quote, cta } from '../data/content'
import { site } from '../data/site'

// O H2 continua sendo `quote.title`; o destaque só quebra a linha e muda a cor.
const at = quote.title.indexOf(quote.highlight)
const tituloA = at > 0 ? quote.title.slice(0, at).trim() : quote.title
const tituloB = at > 0 ? quote.highlight : ''
---

<section id="cotacao" class="relative isolate overflow-hidden bg-neutral-gray-100 pt-8 pb-20">
  {/* Formas claras bem suaves ao fundo (dentro da seção: o corte fica nas laterais e no rodapé) */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <span class="absolute top-10 -left-64 size-[32rem] rounded-full bg-neutral-light/80"></span>
    <span class="absolute top-24 -right-80 size-[46rem] rounded-full bg-neutral-light/70"></span>
  </div>

  <div class="mx-auto max-w-page px-6 pt-8 lg:px-10 lg:pt-12">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      {/* Coluna do formulário */}
      <div class="order-2 w-full lg:order-1">
        <div
          class="quote-slot min-h-[520px] w-full rounded-2xl border border-ink/[0.07] bg-neutral-light p-6 shadow-[0_24px_50px_-30px_rgba(10,29,77,0.35)] sm:p-8"
          data-shortcode-slot
        >
          <slot name="shortcode" />
        </div>

        {/* Nota de LGPD */}
        <p class="mt-6 flex items-start gap-3 font-sans text-[14px] leading-relaxed text-ink-soft sm:text-[15px]">
          <Icon name="lock" class="mt-0.5 size-7 shrink-0 text-ink-soft" />
          <span class="max-w-md">
            {quote.lgpd}
            {site.privacyUrl && (
              <>
                {' '}
                <a
                  href={site.privacyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-primary-dark underline-offset-2 hover:underline"
                >
                  Política de privacidade
                </a>
                .
              </>
            )}
          </span>
        </p>
      </div>

      {/* Coluna de texto */}
      <div class="order-1 lg:order-2">
        <p class="flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.24em] text-ink uppercase sm:text-[14px]">
          <span aria-hidden="true" class="size-2.5 shrink-0 bg-accent-orange"></span>
          {quote.eyebrow}
        </p>

        <h2 class="mt-5 font-display text-[2.3rem] leading-[1.05] font-extrabold tracking-[-0.035em] text-balance text-primary-dark-900 sm:text-[3rem] lg:text-[2.6rem] xl:text-[3.1rem]">
          {tituloA}
          {tituloB && (
            <>
              <br />
              <span class="text-accent-orange">{tituloB}</span>
            </>
          )}
        </h2>

        <p class="mt-6 font-sans text-[17px] leading-relaxed text-ink-soft sm:text-[19px]">
          {quote.text}
        </p>

        <button
          type="button"
          data-cta="cotacao-whatsapp"
          class="btn-slave-whats mt-8 inline-flex w-full items-center justify-center gap-3.5 rounded-xl bg-accent-orange px-9 py-5 font-sans text-[18px] font-semibold text-neutral-light shadow-[0_18px_34px_-16px_rgba(77,127,34,0.75)] transition-colors duration-200 hover:bg-accent-orange-dark sm:w-auto sm:text-[20px]"
        >
          <Icon name="whatsapp" class="size-8 shrink-0" />
          {cta.whatsapp}
        </button>

        <ul class="mt-9 grid gap-5 border-t border-ink/10 pt-8 sm:grid-cols-3 sm:gap-0">
          {quote.trust.map((item) => (
            <li class="quote-trust flex items-start gap-3 font-sans text-[15px] leading-snug text-ink sm:px-4">
              <Icon name={item.icon} class="size-8 shrink-0 text-accent-orange" />
              <span class="pt-0.5">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fora do WordPress: esconde o texto cru do shortcode e deixa o card vazio. */
  .quote-slot:not(:has(*)) {
    font-size: 0;
    color: transparent;
  }

  @media (width >= 40rem) {
    .quote-trust:first-child {
      padding-left: 0;
    }

    .quote-trust + .quote-trust {
      border-left: 1px solid rgb(20 28 46 / 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>
